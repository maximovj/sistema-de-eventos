{
  "name": "with-angular",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start:ui": "turbo run start --filter=@repo/ui --only",
    "start": "turbo run start --filter=web --filter=server --only",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "eslint": "^8.57.0",
    "prettier": "^2.8.8",
    "turbo": "^2.10.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
